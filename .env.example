# Groq API key for LLM explanation layer (Phase 4+).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: path to libclang.dll/.so/.dylib.
# Leave blank to let the `libclang` PyPI package use its bundled binary.
# Override only if you want to use a system LLVM install, e.g.
# LIBCLANG_PATH=C:\Program Files\LLVM\bin\libclang.dll
LIBCLANG_PATH=

# Optional: path to the clang / clang++ binary used for LLVM IR generation.
# Leave blank to use whatever is on PATH. Set this if clang lives somewhere
# unusual (e.g. portable LLVM install). Either a file or a directory works.
# CLANG_PATH=C:\Program Files\LLVM\bin\clang.exe
CLANG_PATH=
